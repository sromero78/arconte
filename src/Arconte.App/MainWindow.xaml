<Window x:Class="Arconte.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Arconte.App.ViewModels"
        xmlns:m="clr-namespace:Arconte.App.Models"
        Title="Arconte" MinWidth="1180" MinHeight="720"
        Width="1280" Height="800" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource FondoVentana}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource FondoControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BordeControl}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Acento}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{DynamicResource FondoControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BordeControl}"/>
        </Style>
        <Style x:Key="ThemedDataGrid" TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{DynamicResource FondoVentana}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BordeCuadricula}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BordeCuadricula}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BordeCuadricula}"/>
            <Setter Property="RowBackground" Value="{DynamicResource FondoVentana}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource FondoPanel}"/>
            <Setter Property="AlternationCount" Value="2"/>
        </Style>
        <Style x:Key="ThemedDataGridRow" TargetType="{x:Type DataGridRow}">
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="Background" Value="{DynamicResource FondoVentana}"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource FondoPanel}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FondoSeleccion}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextoSeleccion}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ThemedDataGridCell" TargetType="{x:Type DataGridCell}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BordeCuadricula}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FondoSeleccion}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextoSeleccion}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ThemedDataGridHeader" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource FondoCabecera}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BordeCuadricula}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource FondoControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BordeControl}"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="{DynamicResource FondoControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource FondoPanel}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Arconte" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextoPrincipal}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Perfil:" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextoPrincipal}"/>
                    <ComboBox Width="220" ItemsSource="{Binding Perfiles}"
                              DisplayMemberPath="Nombre"
                              SelectedItem="{Binding PerfilSeleccionado, Mode=TwoWay}"/>
                    <Button Content="Editar perfiles" Margin="8,0,0,0" Padding="10,4"
                            Click="EditarPerfiles_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tema:" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextoPrincipal}"/>
                    <ComboBox Width="110" ItemsSource="{Binding Temas}"
                              SelectedItem="{Binding TemaSeleccionado, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="12,6" Background="{DynamicResource FondoVentana}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Carpeta, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="6,4"
                         Background="{DynamicResource FondoControl}"
                         Foreground="{DynamicResource TextoPrincipal}"
                         BorderBrush="{DynamicResource BordeControl}"
                         CaretBrush="{DynamicResource TextoPrincipal}"/>
                <Button Grid.Column="1" Content="Seleccionar carpeta" Margin="8,0,0,0"
                        Padding="12,4" Click="SeleccionarCarpeta_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Analizar todos" Padding="12,4" Margin="0,0,8,0"
                        Command="{Binding AnalizarCommand}"/>
                <Button Grid.Column="1" Content="Cancelar" Padding="12,4" Margin="0,0,8,0"
                        Command="{Binding CancelarCommand}"
                        Visibility="{Binding MostrarCancelar, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Grid.Column="2" Content="Aplicar renombrado" Padding="12,4" Margin="0,0,8,0"
                        Click="Aplicar_Click"/>
                <Button Grid.Column="3" Content="Deshacer último lote" Padding="12,4" Margin="0,0,8,0"
                        Command="{Binding DeshacerCommand}"/>
                <Button Grid.Column="4" Content="Exportar historial" Padding="12,4"
                        Click="Exportar_Click"/>
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="160" Height="14" Minimum="0" Maximum="{Binding Total}"
                                 Value="{Binding Progreso}"/>
                    <TextBlock Text="{Binding TextoProgreso}" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextoSecundario}"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="DocumentGrid" Grid.Row="3" Margin="12,6" ItemsSource="{Binding Documentos}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Extended" HeadersVisibility="Column"
                  Style="{StaticResource ThemedDataGrid}"
                  RowStyle="{StaticResource ThemedDataGridRow}"
                  CellStyle="{StaticResource ThemedDataGridCell}"
                  ColumnHeaderStyle="{StaticResource ThemedDataGridHeader}"
                  Background="{DynamicResource FondoVentana}"
                  Foreground="{DynamicResource TextoPrincipal}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay}" Width="40"/>
                <DataGridTextColumn Header="Nombre actual" Binding="{Binding CurrentName}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="Carpeta contenedora" Binding="{Binding FolderName}" IsReadOnly="True" Width="1.2*"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="0.8*"/>
                <DataGridTemplateColumn Header="Código asignado" Width="0.9*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.CatalogoActivo, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      DisplayMemberPath="Codigo" SelectedValuePath="Codigo"
                                      SelectedValue="{Binding Codigo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="False" BorderThickness="0"
                                      Background="{DynamicResource FondoControl}"
                                      Foreground="{DynamicResource TextoPrincipal}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Materia" Binding="{Binding Materia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
                <DataGridTextColumn Header="Identificador" Binding="{Binding Identificador, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
                <DataGridTextColumn Header="Propuesta nuevo nombre" Binding="{Binding ProposedName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTemplateColumn Header="Estado" Width="1.4*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusMessage}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Opacity="0.78"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Background="{DynamicResource FondoPanel}" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Estado}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextoPrincipal}"/>
                <TextBlock Grid.Column="1" Text="Procesamiento 100% local" VerticalAlignment="Center"
                           FontStyle="Italic" Foreground="{DynamicResource TextoSecundario}"/>
            </Grid>
        </Border>
    </Grid>
</Window>

