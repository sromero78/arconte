<Window x:Class="RenombradorDocumental.App.LegalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aviso legal" Width="520" Height="360"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource FondoVentana}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Aviso importante" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource TextoPrincipal}"/>
        <TextBlock Grid.Row="1" Margin="0,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextoPrincipal}">
            Esta aplicación procesa sus documentos íntegramente en este equipo.
            No se envían archivos ni metadatos a ningún servidor externo; la única
            comunicación de red posible es con una instancia local de Ollama en
            este mismo equipo (loopback).
            &#x0a;&#x0a;
            Los nombres propuestos son sugerencias automáticas. Debe revisar y
            validar la vista previa antes de aplicar el renombrado. Usted es el
            responsable de los cambios aplicados a sus archivos. Existe una
            función de deshacer para el último lote, pero no sustituye a una
            copia de seguridad.
        </TextBlock>
        <Button Grid.Row="2" Content="Entendido" Width="120" HorizontalAlignment="Right"
                IsDefault="True" Click="Entendido_Click"/>
    </Grid>
</Window>
