<Window x:Class="RenombradorDocumental.App.ProfileEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor visual de perfiles" Width="980" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FondoVentana}">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource FondoControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BordeControl}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{DynamicResource FondoControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BordeControl}"/>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="{DynamicResource FondoControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource FondoControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BordeControl}"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{DynamicResource FondoVentana}"/>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Perfil a editar:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Perfiles}"
                      DisplayMemberPath="Nombre"
                      SelectedItem="{Binding PerfilSeleccionado, Mode=TwoWay}"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextoSecundario}">
                <Run Text="Perfil activo: "/><Run Text="{Binding PerfilActivoId}"/>
            </TextBlock>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Ajustes generales">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <Grid MaxWidth="560" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Nombre del perfil:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                                 Text="{Binding PerfilSeleccionado.Nombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Text="Formato de fecha:" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                                  ItemsSource="{Binding FormatosFecha}"
                                  SelectedItem="{Binding PerfilSeleccionado.FormatoFecha, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="2" Text="Separador:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" MaxLength="4"
                                 Text="{Binding PerfilSeleccionado.Separador, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="3" Text="Regla de caja:" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4"
                                  ItemsSource="{Binding ReglasCaja}"
                                  SelectedItem="{Binding PerfilSeleccionado.ReglaCaja, Mode=TwoWay}"/>

                        <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,8"
                                  Content="Extensión en mayúsculas"
                                  IsChecked="{Binding PerfilSeleccionado.ExtensionMayusculas, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="Orden de estructura"
                                   FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <TextBlock Grid.Row="6" Text="Posición 1:" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Componentes}"
                                  SelectedItem="{Binding PerfilSeleccionado.OrdenEstructura[0], Mode=TwoWay}"/>
                        <TextBlock Grid.Row="7" Text="Posición 2:" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Componentes}"
                                  SelectedItem="{Binding PerfilSeleccionado.OrdenEstructura[1], Mode=TwoWay}"/>
                        <TextBlock Grid.Row="8" Text="Posición 3:" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox Grid.Row="8" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Componentes}"
                                  SelectedItem="{Binding PerfilSeleccionado.OrdenEstructura[2], Mode=TwoWay}"/>
                        <TextBlock Grid.Row="9" Text="Posición 4:" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox Grid.Row="9" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Componentes}"
                                  SelectedItem="{Binding PerfilSeleccionado.OrdenEstructura[3], Mode=TwoWay}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Catálogo de códigos">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="CatalogGrid"
                              ItemsSource="{Binding PerfilSeleccionado.Catalogo}"
                              SelectedItem="{Binding CodigoSeleccionado, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="{DynamicResource FondoVentana}"
                              Foreground="{DynamicResource TextoPrincipal}"
                              BorderBrush="{DynamicResource BordeCuadricula}"
                              HorizontalGridLinesBrush="{DynamicResource BordeCuadricula}"
                              VerticalGridLinesBrush="{DynamicResource BordeCuadricula}"
                              RowBackground="{DynamicResource FondoVentana}"
                              AlternatingRowBackground="{DynamicResource FondoPanel}"
                              AlternationCount="2">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource FondoSeleccion}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextoSeleccion}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource FondoSeleccion}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextoSeleccion}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource FondoCabecera}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextoPrincipal}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BordeCuadricula}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Código" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Codigo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 CharacterCasing="Upper" MaxLength="3"
                                                 Background="{DynamicResource FondoControl}"
                                                 Foreground="{DynamicResource TextoPrincipal}"
                                                 BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Familia" Width="*"
                                                Binding="{Binding Categoria, Mode=TwoWay}"/>
                            <DataGridTextColumn Header="Concepto" Width="*"
                                                Binding="{Binding Descripcion, Mode=TwoWay}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Añadir código" Width="140" Margin="0,0,8,0" Click="AgregarCodigo_Click"/>
                        <Button Content="Eliminar código" Width="140" Click="EliminarCodigo_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Modo JSON (consulta)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="JsonPreview" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{DynamicResource FondoControl}"
                             Foreground="{DynamicResource TextoPrincipal}"
                             BorderBrush="{DynamicResource BordeControl}"/>
                    <Button Grid.Row="1" Content="Actualizar vista" Width="140" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="ActualizarJson_Click"/>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" x:Name="ValidationMessage" Foreground="{DynamicResource TextoError}"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" Width="120" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Validar y guardar" Width="150" IsDefault="True" Click="Guardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
